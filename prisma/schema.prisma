generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  slug   String  @unique
  videos Video[]
}

model Tag {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  slug   String  @unique
  videos Video[]
}

model Video {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  description String?
  embedUrl    String
  thumbnail   String?
  backgroundImage String?
  duration    String?
  studio      String?
  releasedAt  DateTime?
  previewHtml String?
  source      String?
  published   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  views       Int        @default(0)
  categories  Category[]
  tags        Tag[]
  viewEvents  VideoView[]
  reports     Report[]
  alerts      VideoAlert[]

  @@index([releasedAt])
}

model VideoAlert {
  id        Int      @id @default(autoincrement())
  videoId   Int
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reason    String
  source    String // "auto" (embed format check on save) | "manual" (Verificar reproducción button)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([videoId, source, resolved])
}

model Report {
  id           Int      @id @default(autoincrement())
  videoId      Int
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  message      String
  contactEmail String?
  diagnostics  String?
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model VideoView {
  id        Int      @id @default(autoincrement())
  videoId   Int
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([videoId, createdAt])
}

model SiteSetting {
  key   String @id
  value String
}

model Visit {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())
  country     String?
  landingPage String
  referrer    String?
  userAgent   String?
  ip          String?
  isAdmin     Boolean    @default(false)
  playsCount  Int        @default(0)
  pageViews   PageView[]

  @@index([createdAt])
  @@index([ip, createdAt])
}

model PageView {
  id        Int      @id @default(autoincrement())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SearchQuery {
  id        Int      @id @default(autoincrement())
  term      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
