generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  slug   String  @unique
  videos Video[]
}

model Tag {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  slug   String  @unique
  videos Video[]
}

model Video {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  description String?
  embedUrl    String
  thumbnail   String?
  backgroundImage String?
  duration    String?
  studio      String?
  releasedAt  DateTime?
  previewHtml String?
  source      String?
  published   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  views       Int        @default(0)
  malTitle       String?
  malUrl         String?
  malScore       String?
  malRanked      String?
  malPopularity  String?
  malMembers     String?
  malCheckedAt   DateTime?
  categories  Category[]
  tags        Tag[]
  viewEvents  VideoView[]
  reports     Report[]
  alerts      VideoAlert[]

  @@index([releasedAt])
}

model VideoAlert {
  id        Int      @id @default(autoincrement())
  videoId   Int
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reason    String
  source    String // "auto" (embed format check on save) | "manual" (Verificar reproducción button)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([videoId, source, resolved])
}

model Report {
  id           Int      @id @default(autoincrement())
  videoId      Int
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  message      String
  contactEmail String?
  diagnostics  String?
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model VideoView {
  id        Int      @id @default(autoincrement())
  videoId   Int
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([videoId, createdAt])
}

model SiteSetting {
  key   String @id
  value String
}

model Visit {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())
  country     String?
  landingPage String
  referrer    String?
  userAgent   String?
  ip          String?
  fingerprint String?
  isAdmin     Boolean    @default(false)
  playsCount  Int        @default(0)
  pageViews   PageView[]

  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([fingerprint])
}

model PageView {
  id        Int      @id @default(autoincrement())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  path      String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Motor de detección de scraping (fase 1: señales + puntaje).
// Puntaje acumulado por IP; `fingerprint` guarda la última huella de
// headers vista para esa IP y sirve para detectar rotación de IPs con la
// misma huella (ver scoreByFingerprint en lib/scoring/engine.ts).
model IpScore {
  ip           String        @id
  fingerprint  String?
  score        Int           @default(0)
  state        String        @default("observado") // observado | sospechoso | confirmado
  requestCount Int           @default(0)
  assetHits    Int           @default(0)
  htmlHits     Int           @default(0)
  verifiedBot  Boolean       @default(false)
  botName      String?
  whitelisted  Boolean       @default(false)
  honeypotHit  Boolean       @default(false)
  country      String?
  firstSeenAt  DateTime      @default(now())
  lastSeenAt   DateTime      @default(now())
  signals      ScoreSignal[]

  @@index([score])
  @@index([state])
  @@index([fingerprint])
}

// Desglose auditable: una fila por cada vez que una señal disparó y sumó
// puntos para una IP. Nunca se sobreescribe, solo se purga por retención.
model ScoreSignal {
  id        Int      @id @default(autoincrement())
  ip        String
  ipScore   IpScore  @relation(fields: [ip], references: [ip], onDelete: Cascade)
  key       String
  weight    Int
  detail    String?
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([key, createdAt])
}

model SearchQuery {
  id        Int      @id @default(autoincrement())
  term      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
